#include <dt-bindings/spmi/spmi.h>

pmh0101@1 {
	comptaible = "qcom,spmi-pmic";
	reg = <1 SPMI_USID>;
	#address-cells = <1>;
	#size-cells = <0>;

	pmh0101_gpios: pinctrl@8800 {
		compatible = "qcom,pmh0101-gpio";
		reg = <0x8800>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};
};
