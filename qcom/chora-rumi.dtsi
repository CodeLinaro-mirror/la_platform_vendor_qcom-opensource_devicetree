&chosen {
	bootargs = "printk.devkmsg=on loglevel=8 nokaslr kpti=0 log_buf_len=256K swiotlb=0 slub_debug=- cpufreq.default_governor=performance";
};

&arch_timer {
	clock-frequency = <5000000>;
};

&memtimer {
	clock-frequency = <5000000>;
};

&CPU0 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU1 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU2 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU3 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU4 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU5 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU6 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&CPU7 {
	enable-method = "spin-table"; /* TODO: Update to psci */
	cpu-release-addr = <0x0 0x90000000>;
};

&psci {
	status = "disabled";
};

&soc {
	usb_nop_phy: usb_nop_phy {
		compatible = "usb-nop-xceiv";
	};

	usb_emuphy: phy@a784000 {
		compatible = "qcom,usb-emu-phy";
		reg = <0x0 0x0a784000 0x0 0x9500>;

		qcom,emu-init-seq = <0xfffff 0x4
			0xffff0 0x4
			0x100000 0x20
			0x0 0x20
			0x000101F0 0x20
			0x00100000 0x3c
			0x0 0x3c
			0x0 0x4
			0x9 0x14>;
	};
};

&usb0 {
	dwc3@a600000 {
		usb-phy = <&usb_emuphy>, <&usb_nop_phy>;
		dr_mode = "peripheral";
		maximum-speed = "high-speed";
	};
};
