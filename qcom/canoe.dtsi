		clock-output-names = "videocc_clocks";
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	apsscc: syscon@17c00000 {
		compatible = "syscon";
		reg = <0x0 0x17c00000 0x0 0x2da3000>;
	};

	gxclkctl: syscon@3d64000 {
		compatible = "syscon";
		reg = <0x0 0x3d64000 0x0 0x5000>;
	};

	mccc: syscon@310ba000 {
		compatible = "syscon";
