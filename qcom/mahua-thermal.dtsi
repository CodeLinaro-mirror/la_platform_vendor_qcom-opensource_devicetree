	/* ---- TSENS0: CPU.0.4.0 (port 9) ---- */
	cpu-0-4-0-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 9>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu040_emerg0: cpu040-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu040_emerg0_1: cpu040-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu040_cdev {
				trip = <&cpu040_emerg0>;
				cooling-device = <&cpu4_pause 0 1>;
			};

			cpu040_cdev1 {
				trip = <&cpu040_emerg0_1>;
				cooling-device = <&cpu4_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.4.1 (port 10) ---- */
	cpu-0-4-1-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 10>;
