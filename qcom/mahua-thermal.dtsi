				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu030_cdev {
				trip = <&cpu030_emerg0>;
				cooling-device = <&cpu3_pause 0 1>;
			};

			cpu030_cdev1 {
				trip = <&cpu030_emerg0_1>;
				cooling-device = <&cpu3_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.3.1 (port 8) ---- */
	cpu-0-3-1-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 8>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu031_emerg0: cpu031-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu031_emerg0_1: cpu031-emerg0-1-cfg {
				temperature = <110000>;
