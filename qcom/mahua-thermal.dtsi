				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu020_cdev {
				trip = <&cpu020_emerg0>;
				cooling-device = <&cpu2_pause 0 1>;
			};

			cpu020_cdev1 {
				trip = <&cpu020_emerg0_1>;
				cooling-device = <&cpu2_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.2.1 (port 6) ---- */
	cpu-0-2-1-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 6>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu021_emerg0: cpu021-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu021_emerg0_1: cpu021-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu021_cdev {
				trip = <&cpu021_emerg0>;
				cooling-device = <&cpu2_pause 0 1>;
			};

			cpu021_cdev1 {
				trip = <&cpu021_emerg0_1>;
				cooling-device = <&cpu2_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.3.0 (port 7) ---- */
	cpu-0-3-0-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 7>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu030_emerg0: cpu030-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu030_emerg0_1: cpu030-emerg0-1-cfg {
				temperature = <110000>;
