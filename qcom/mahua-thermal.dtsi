#include <dt-bindings/thermal/thermal_qti.h>

/*
 * GPU cooling cell — required for thermal mitigation
 */
&msm_gpu {
	#cooling-cells = <2>;
};

/*
 * Cooling Devices
 * cpu0-cpu11 = 12 cores total (Mahua.AL)
 * Cluster 0 / CPU.0.*: cpu0-cpu5
 * Cluster 1 / CPU.1.*: cpu6-cpu11
 */
&soc {
		tsens0: thermal-sensor@c22c000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c22c000 0x0 0x1000>,
			<0x0 0x0c222000 0x0 0x1000>;
		interrupts = <GIC_SPI 771 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 861 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <13>;
		#thermal-sensor-cells = <1>;
	};

	tsens1: thermal-sensor@c22d000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c22d000 0x0 0x1000>,
			<0x0 0x0c223000 0x0 0x1000>;

		interrupts = <GIC_SPI 772 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 862 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <9>;
		#thermal-sensor-cells = <1>;
	};

	tsens2: thermal-sensor@c22e000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c22e000 0x0 0x1000>,
			<0x0 0x0c224000 0x0 0x1000>;

		interrupts = <GIC_SPI 773 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 863 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <13>;
		#thermal-sensor-cells = <1>;
	};

	tsens3: thermal-sensor@c22f000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c22f000 0x0 0x1000>,
			<0x0 0x0c225000 0x0 0x1000>;

		interrupts = <GIC_SPI 774 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 864 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <8>;
		#thermal-sensor-cells = <1>;
	};

	tsens4: thermal-sensor@c230000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c230000 0x0 0x1000>,
			<0x0 0x0c226000 0x0 0x1000>;

		interrupts = <GIC_SPI 791 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 865 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <11>;
		#thermal-sensor-cells = <1>;
	};

	tsens5: thermal-sensor@c231000 {
		compatible = "qcom,glymur-tsens", "qcom,tsens-v2";
		reg = <0x0 0x0c231000 0x0 0x1000>,
			<0x0 0x0c227000 0x0 0x1000>;

		interrupts = <GIC_SPI 619 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 814 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow",
			"critical";
		#qcom,sensors = <15>;
		#thermal-sensor-cells = <1>;
	};

	qcom,cpu-pause {
		compatible = "qcom,thermal-pause";

		/* --- Individual CPU pause cooling devices --- */
		cpu0_pause: cpu0-pause {
			qcom,cpus = <&cpu0>;
			qcom,cdev-alias = "thermal-pause-1";
			#cooling-cells = <2>;
		};

		cpu1_pause: cpu1-pause {
			qcom,cpus = <&cpu1>;
			qcom,cdev-alias = "thermal-pause-2";
			#cooling-cells = <2>;
		};

		cpu2_pause: cpu2-pause {
			qcom,cpus = <&cpu2>;
			qcom,cdev-alias = "thermal-pause-4";
			#cooling-cells = <2>;
		};

		cpu3_pause: cpu3-pause {
			qcom,cpus = <&cpu3>;
			qcom,cdev-alias = "thermal-pause-8";
			#cooling-cells = <2>;
		};

		cpu4_pause: cpu4-pause {
			qcom,cpus = <&cpu4>;
			qcom,cdev-alias = "thermal-pause-10";
			#cooling-cells = <2>;
		};

		cpu5_pause: cpu5-pause {
			qcom,cpus = <&cpu5>;
			qcom,cdev-alias = "thermal-pause-20";
			#cooling-cells = <2>;
		};

		cpu6_pause: cpu6-pause {
			qcom,cpus = <&cpu6>;
			qcom,cdev-alias = "thermal-pause-40";
			#cooling-cells = <2>;
		};

		cpu7_pause: cpu7-pause {
			qcom,cpus = <&cpu7>;
			qcom,cdev-alias = "thermal-pause-80";
			#cooling-cells = <2>;
		};

		cpu8_pause: cpu8-pause {
			qcom,cpus = <&cpu8>;
			qcom,cdev-alias = "thermal-pause-100";
			#cooling-cells = <2>;
		};

		cpu9_pause: cpu9-pause {
			qcom,cpus = <&cpu9>;
			qcom,cdev-alias = "thermal-pause-200";
			#cooling-cells = <2>;
		};

		cpu10_pause: cpu10-pause {
			qcom,cpus = <&cpu10>;
			qcom,cdev-alias = "thermal-pause-400";
			#cooling-cells = <2>;
		};

		cpu11_pause: cpu11-pause {
			qcom,cpus = <&cpu11>;
			qcom,cdev-alias = "thermal-pause-800";
			#cooling-cells = <2>;
		};

		/* ---Cluster-level pause cooling devices --- */
		/*
		 * Cluster 0: cpu0-cpu5
		 * CPU bit mask: 0x03F
		 */

		APC0_MX_CX_PAUSE: apc0-mx-cx-pause {
			qcom,cpus = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5>;
			qcom,cdev-alias = "thermal-pause-3F";
			#cooling-cells = <2>;
		};

		/*
		 * Cluster 1: cpu6-cpu11
		 * CPU bit mask: 0xFC0
		 */
		APC1_MX_CX_PAUSE: apc1-mx-cx-pause {
			qcom,cpus = <&cpu6 &cpu7 &cpu8 &cpu9 &cpu10 &cpu11>;
			qcom,cdev-alias = "thermal-pause-FC0";
			#cooling-cells = <2>;
		};
	};

	/*
	 * CPU Hotplug cooling devices (cpu0-cpu11)
	 */
	qcom,cpu-hotplug {
		compatible = "qcom,cpu-hotplug";

		cpu0_hotplug: cpu0-hotplug {
			qcom,cpu = <&cpu0>;
			qcom,cdev-alias = "cpu-hotplug0";
			#cooling-cells = <2>;
		};

		cpu1_hotplug: cpu1-hotplug {
			qcom,cpu = <&cpu1>;
			qcom,cdev-alias = "cpu-hotplug1";
			#cooling-cells = <2>;
		};

		cpu2_hotplug: cpu2-hotplug {
			qcom,cpu = <&cpu2>;
			qcom,cdev-alias = "cpu-hotplug2";
			#cooling-cells = <2>;
		};

		cpu3_hotplug: cpu3-hotplug {
			qcom,cpu = <&cpu3>;
			qcom,cdev-alias = "cpu-hotplug3";
			#cooling-cells = <2>;
		};

		cpu4_hotplug: cpu4-hotplug {
			qcom,cpu = <&cpu4>;
			qcom,cdev-alias = "cpu-hotplug4";
			#cooling-cells = <2>;
		};

		cpu5_hotplug: cpu5-hotplug {
			qcom,cpu = <&cpu5>;
			qcom,cdev-alias = "cpu-hotplug5";
			#cooling-cells = <2>;
		};

		cpu6_hotplug: cpu6-hotplug {
			qcom,cpu = <&cpu6>;
			qcom,cdev-alias = "cpu-hotplug6";
			#cooling-cells = <2>;
		};

		cpu7_hotplug: cpu7-hotplug {
			qcom,cpu = <&cpu7>;
			qcom,cdev-alias = "cpu-hotplug7";
			#cooling-cells = <2>;
		};

		cpu8_hotplug: cpu8-hotplug {
			qcom,cpu = <&cpu8>;
			qcom,cdev-alias = "cpu-hotplug8";
			#cooling-cells = <2>;
		};

		cpu9_hotplug: cpu9-hotplug {
			qcom,cpu = <&cpu9>;
			qcom,cdev-alias = "cpu-hotplug9";
			#cooling-cells = <2>;
		};

		cpu10_hotplug: cpu10-hotplug {
			qcom,cpu = <&cpu10>;
			qcom,cdev-alias = "cpu-hotplug10";
			#cooling-cells = <2>;
		};

		cpu11_hotplug: cpu11-hotplug {
			qcom,cpu = <&cpu11>;
			qcom,cdev-alias = "cpu-hotplug11";
			#cooling-cells = <2>;
		};
	};

	/*
	 * GPU devfreq cooling device
	 */
	qcom,devfreq-cdev {
		compatible = "qcom,devfreq-cdev";
		qcom,devfreq = <&msm_gpu>;
	};

	/*
	 * CPUfreq cooling devices
	 * Cluster0: cpu0-cpu5  (TSENS0 / CPU.0)
	 * Cluster1: cpu6-cpu11 (TSENS2 / CPU.1)
	 */
	qcom,cpufreq-cdev {
		compatible = "qcom,cpufreq-cdev";

		cpu-cluster0 {
			qcom,cpus = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5>;
		};

		cpu-cluster1 {
			qcom,cpus = <&cpu6 &cpu7 &cpu8 &cpu9 &cpu10 &cpu11>;
		};
	};

	/*
	 * QMI TMD cooling devices (CDSP)
	 */
	qmi_tmd: qmi-tmd-devices {
		compatible = "qcom,qmi-cooling-devices";

		cdsp {
			qcom,instance-id = <QMI_CDSP_INST_ID>;

			cdsp_sw: cdsp {
				qcom,qmi-dev-name = "cdsp_sw";
				#cooling-cells = <2>;
			};
		};
	};
};

/*
 * Thermal Zones — Mahua.AL
 * SW Channel → Controller/Port mapping:
 *
 * TSENS0 (13 sensors, ch 0-12):
 *   ch0=AOSS.0  ch1-12=CPU.0.0.0~CPU.0.5.1
 *
 * TSENS1 (9 sensors, ch 13-21):
 *   ch13=AOSS.1  ch14-15=CPULLC.0.0/1
 *   ch16-18=QMX.0.0/1/2  ch19-20=DDR.0/1  ch21=VIDEO.0
 *
 * TSENS2 (13 sensors, ch 22-34):
 *   ch22=AOSS.2  ch23-34=CPU.1.0.0~CPU.1.5.1
 *
 * TSENS3 (8 sensors, ch 35-42):
 *   ch35=AOSS.3  ch36-37=CPULLC.1.0/1
 *   ch38-42=QMX.1.0/1/2/3/4
 *
 * TSENS4 (11 sensors, ch 43-53):
 *   ch43=AOSS.4  ch44-47=NSPHVX.0/1/2/3
 *   ch48-51=NSPHMX.0/1/2/3  ch52-53=CAMERA.0/1
 *
 * TSENS5 (15 sensors, ch 54-68):
 *   ch54=AOSS.5  ch55-63=GPU.0.0~GPU.2.2
 *   ch64-68=GPUSS.0/1 are enabled - /2/3/4 Not enabled
 */
&thermal_zones {

	/* ---- TSENS0: AOSS.0 (port 0) ---- */
	aoss-0-thermal {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 0>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};
	};

	/* ---- TSENS0: CPU.0.0.0 (port 1) ---- */
	cpu-0-0-0-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 1>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu000_emerg0: cpu000-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu000_emerg0_1: cpu000-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};
	};

	/* ---- TSENS0: CPU.0.0.1 (port 2) ---- */
	cpu-0-0-1-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 2>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu001_emerg0: cpu001-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu001_emerg0_1: cpu001-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

	};

	/* ---- TSENS0: CPU.0.1.0 (port 3) ---- */
	cpu-0-1-0-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 3>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu010_emerg0: cpu010-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu010_emerg0_1: cpu010-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu010_cdev {
				trip = <&cpu010_emerg0>;
				cooling-device = <&cpu1_pause 0 1>;
			};

			cpu010_cdev1 {
				trip = <&cpu010_emerg0_1>;
				cooling-device = <&cpu1_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.1.1 (port 4) ---- */
	cpu-0-1-1-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 4>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu011_emerg0: cpu011-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu011_emerg0_1: cpu011-emerg0-1-cfg {
				temperature = <110000>;
				hysteresis = <10000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <0>;
				type = "hot";
			};
		};

		cooling-maps {
			cpu011_cdev {
				trip = <&cpu011_emerg0>;
				cooling-device = <&cpu1_pause 0 1>;
			};

			cpu011_cdev1 {
				trip = <&cpu011_emerg0_1>;
				cooling-device = <&cpu1_hotplug 0 1>;
			};
		};
	};

	/* ---- TSENS0: CPU.0.2.0 (port 5) ---- */
	cpu-0-2-0-thermal {
		polling-delay-passive = <250>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 5>;
		trips {
			thermal-engine-config {
				temperature = <135000>;
				hysteresis = <5000>;
				type = "passive";
			};

			thermal-hal-config {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};

			cpu020_emerg0: cpu020-emerg0-cfg {
				temperature = <108000>;
				hysteresis = <8000>;
				type = "passive";
			};

			cpu020_emerg0_1: cpu020-emerg0-1-cfg {
				temperature = <110000>;
