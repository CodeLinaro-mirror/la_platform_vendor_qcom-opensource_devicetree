/* 1GB-only overrides shared by Shikra CQM/CQS variants. */

/delete-node/ &cdsp_pas;

&reserved_memory {
	/delete-node/ pvm_fw_region@86300000;
	/delete-node/ cdsp_region@b2400000;
	/delete-node/ tags_region@a0100000;
	/delete-node/ audio_mdsp_carveout_region@86400000;
	/delete-node/ trust_ui_vm_region@f3800000;
	hyp_mem: hyp_region@80000000 {
		no-map;
		reg = <0x0 0x80000000 0x0 0x0a00000>;
	};

	audio_mdsp_carveout_mem: audio_mdsp_carveout_region@86300000 {
		no-map;
		reg = <0x0 0x86300000 0x0 0x500000>;
	};

	tags_mem: tags_region@a0e00000 {
		no-map;
		reg = <0x0 0xa0e00000 0x0 0x500000>;
	};

	tz_apps_mem: tz_apps_region@a1800000 {
		no-map;
		reg = <0x0 0xa1800000 0x0 0xa00000>;
	};
};

&soc {
	/delete-node/ gunyah-cma-mem;
};
