&soc {
	usb_emuphy: phy@a71c000 {
		compatible = "qcom,usb-emu-phy";
		reg = <0xA71C000 0x9500>;

		qcom,emu-init-seq = <0xfff0 0x4
					0xfff3 0x4
					0xfff0 0x4
					0x100000 0x20
					0x0 0x20
					0x1e0 0x20
					0x100000 0x3c
					0x0 0x3c
					0x4 0x3c
					0x0 0x4
					0x9 0x14>;
	};
};

&arch_timer {
	clock-frequency = <5000000>;
};

&memtimer {
	clock-frequency = <5000000>;
};

&uart5 {
	qcom,rumi_platform;
	status = "ok";
};

&usb0 {
	dwc3@a600000 {
		usb-phy = <&usb_emuphy>, <&usb_nop_phy>;
		dr_mode = "peripheral";
	};
};

&GOLD_OFF {
	status = "disabled";
};

&GOLD_RAIL_OFF {
	status = "disabled";
};

&SILVER_OFF {
	status = "disabled";
};

&SILVER_RAIL_OFF {
	status = "disabled";
};

&CLUSTER_PWR_DN {
	status = "disabled";
};

&CX_RET {
	status = "disabled";
};

&rpmhcc {
	compatible = "fixed-clock";
	clock-output-names = "rpmh_clocks";
	clock-frequency = <19200000>;
};

&eusb2_phy0 {
	status = "disabled";
};

&tsens0 {
	status = "disabled";
};

