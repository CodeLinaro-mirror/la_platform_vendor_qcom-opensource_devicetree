&soc {
	emac0_phy_pwr: regulator-emac0-phy {
			compatible = "regulator-fixed";
			regulator-name = "vreg_rgmii";
			gpio = <&tlmm 66 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			pinctrl-0 = <&emac0_phy_pwr_default>;
			pinctrl-names = "default";
	};
};

