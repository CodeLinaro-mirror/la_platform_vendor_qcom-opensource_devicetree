&i2c3 {
	status = "ok";
	#address-cells = <1>;
	#size-cells = <0>;

	expander0: pca953x@38 {
		compatible = "ti,tca9538";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x38>;
	};

	expander1: pca953x@3C {
		compatible = "ti,tca9538";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x3C>;

		io-exp-hog6 {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "keye_pwr_en";
		};
	};

	expander2: pca953x@20 {
		compatible = "ti,tca9539";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x20>;
	};

	expander3: pca953x@21 {
		compatible = "ti,tca9539";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x21>;
	};

	pcie0_i2c_ctrl: pcie0_i2c_ctrl {
		compatible = "qcom,pcie-i2c-ntn3";
		rc-index = <0x0>;
		reg = <0x77>;
		gpio-config-reg = <0x801208>;
		ep-reset-reg = <0x801210>;
		ep-reset-gpio-mask = <0xc>;
		version-reg = <0x800000>;
		dump-regs = <0x801330 0x801350 0x801370>;
		reg_update = <0x82c030 0x1
				0x828000 0x3
				0x82bd00 0x8
				0x82c030 0x2
				0x828000 0x3
				0x82bd00 0x8
				0x82c030 0x8
				0x828000 0x1
				0x82bd00 0x8
				0x82c01c 0x10
				0x82c030 0xf
				0x828000 0xf
				0x82b268 0x2>;

		/*FOM for preset caluclation*/
		switch_reg_update = <0x82c02c 0x00000007
				0x824a10 0x00000001
				0x82c030 0x00000008
				0x828000 0x00000001
				0x82b074 0x00000020
				0x82b2bc 0x00000001
				/*Set GPIOs 2&4 as high to enable power*/
				0x801208 0xffffffeb
				0x801210 0x14>;
	};
};

&pcie0 {
	status = "ok";

	pcie-i2c-phandle = <&pcie0_i2c_ctrl>;
	qcom,no-client-based-bw-voting;
	vreg-1p2-supply = <&L12A>;

	iommu-map = <0x0 &apps_smmu 0x0800 0x1>,
		<0x100 &apps_smmu 0x0801 0x1>,
		<0x208 &apps_smmu 0x0802 0x1>,
		<0x210 &apps_smmu 0x0803 0x1>,
		<0x218 &apps_smmu 0x0804 0x1>,
		<0x300 &apps_smmu 0x0805 0x1>,
		<0x400 &apps_smmu 0x0806 0x1>,
		<0x500 &apps_smmu 0x0807 0x1>,
		<0x501 &apps_smmu 0x0808 0x1>;
};

&pcie0_msi {
	status = "ok";
};

&pcie0_rp {
	#address-cells = <5>;
	#size-cells = <0>;
	/* BDF 1.0.0 */
	pcie1_bus1_dev0_fn0: pcie1_bus1_dev0_fn0 {
		reg = <0 0 0 0 0>;

		/* BDF 2.1.0 */
		pcie1_bus2_dev1_fn0: pcie1_bus2_dev1_fn0 {
			reg = <0x800 0x0 0x0 0x0 0x0>;
		};

		/* BDF 2.2.0 */
		pcie1_bus2_dev2_fn0: pcie1_bus2_dev2_fn0 {
			reg = <0x1000 0x0 0x0 0x0 0x0>;
			/* BDF 4.0.0 */
			pcie1_bus4_dev0_fn0: pcie1_bus4_dev0_fn0 {
				reg = <0x0 0x0 0x0 0x0 0x0>;
				#address-cells = <1>;
				#size-cells = <1>;
			};
		};

		/* BDF 2.3.0 */
		pcie1_bus2_dev3_fn0: pcie1_bus2_dev3_fn0 {
			reg = <0x1800 0x0 0x0 0x0 0x0>;
		};
	};
};

&sdhc_1 {
	pinctrl-0 = <&sdc1_on>;
	pinctrl-1 = <&sdc1_off>;
	pinctrl-names = "default", "sleep";

	vdd-supply = <&L17A>;
	qcom,vdd-voltage-level = <2952000 2952000>;
	qcom,vdd-current-level = <0 570340>;

	vdd-io-supply = <&S4A>;
	qcom,vdd-io-always-on;
	qcom,vdd-io-lpm-sup;
	qcom,vdd-io-voltage-level = <1800000 1800000>;
	qcom,vdd-io-current-level = <0 325560>;

	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;

	status = "okay";
};

&sdhc_2 {
	vdd-supply = <&L10A>;
	qcom,vdd-current-level = <0 976310>;
	qcom,vdd-voltage-level = <2950000 2950000>;

	vdd-io-supply = <&L2A>;
	qcom,vdd-io-voltage-level = <1800000 2960000>;
	qcom,vdd-io-current-level = <0 22000>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;

	cd-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;

	resets = <&gcc GCC_SDCC2_BCR>;
	reset-names = "core_reset";

	status = "ok";
};

&ethernet {
	status = "okay";
	phy-handle = <&rgmii_phy>;
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	vreg_rgmii-supply = <&emac0_phy_pwr>;

	pinctrl-names = "default";
	pinctrl-0 = <&ethernet0_defaults>;

	snps,mtl-rx-config = <&mtl_rx_setup>;
	snps,mtl-tx-config = <&mtl_tx_setup>;

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		rgmii_phy: ethernet-phy@7 {
			reg = <7>;
			compatible = "ethernet-phy-id2000.a231";
			reset-gpios = <&tlmm 135 GPIO_ACTIVE_LOW>;
			reset-assert-us = <11000>;
			reset-deassert-us = <70000>;
			ti,tx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
			ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		};
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <1>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,map-to-dma-channel = <0x0>;
			snps,route-up;
			snps,priority = <0x1>;
		};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <1>;
		snps,tx-sched-wrr;

		queue0 {
			snps,weight = <0x10>;
			snps,dcb-algorithm;
			snps,priority = <0x0>;
		};
	};
};

&tlmm {
	emac0_phy_pwr_default: emac0-phy-pwr-default-state {
		pins = "gpio66";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	ethernet0_defaults: ethernet0-defaults-state {
		mdc-pins {
				pins = "gpio134";
				function = "rgmii0_mdc";
				bias-pull-up;
				drive-strength = <16>;
		};

		mdio-pins {
				pins = "gpio133";
				function = "rgmii0_mdio";
				bias-pull-up;
				drive-strength = <16>;
		};

		rgmii-rxc-pins {
				pins = "gpio121";
				function = "rgmii0_rxc";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-rxctl-pins {
				pins = "gpio122";
				function = "rgmii0_rx_ctl";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-rxd0-pins {
				pins = "gpio123";
				function = "rgmii0_rxd0";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-rxd1-pins {
				pins = "gpio124";
				function = "rgmii0_rxd1";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-rxd2-pins {
				pins = "gpio125";
				function = "rgmii0_rxd2";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-rxd3-pins {
				pins = "gpio126";
				function = "rgmii0_rxd3";
				bias-disable;
				drive-strength = <16>;
		};

		rgmii-txc-pins {
				pins = "gpio127";
				function = "rgmii0_txc";
				bias-pull-up;
				drive-strength = <16>;
		};

		rgmii-txctl-pins {
				pins = "gpio128";
				function = "rgmii0_tx_ctl";
				bias-pull-up;
				drive-strength = <16>;
		};

		rgmii-txd0-pins {
			pins = "gpio129";
			function = "rgmii0_txd0";
			bias-pull-up;
			drive-strength = <16>;
		};

		rgmii-txd1-pins {
			pins = "gpio130";
			function = "rgmii0_txd1";
			bias-pull-up;
			drive-strength = <16>;
		};

		rgmii-txd2-pins {
			pins = "gpio131";
			function = "rgmii0_txd2";
			bias-pull-up;
			drive-strength = <16>;
		};

		rgmii-txd3-pins {
			pins = "gpio132";
			function = "rgmii0_txd3";
			bias-pull-up;
			drive-strength = <16>;
		};

		phy-intr-pins {
				pins = "gpio120";
				function = "emac0_phy";
				bias-disable;
				drive-strength = <16>;
		};

		phy-reset-pins {
				pins = "gpio135";
				function = "gpio";
				bias-pull-up;
				drive-strength = <16>;
		};
	};
};

&uart0 {
	status = "okay";
};

&usb0 {
	extcon = <&eud>;
};

&usb1 {
	qcom,default-mode-none;
};
